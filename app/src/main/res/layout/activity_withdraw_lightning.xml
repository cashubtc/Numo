<?xml version="1.0" encoding="utf-8"?>
<com.electricdreams.numo.ui.components.SettingsPageLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".feature.settings.WithdrawLightningActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.electricdreams.numo.ui.components.NumoTopBar
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:topBarSettingsStyle="true"
            app:topBarTitle="@string/withdraw_send_title" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/settings_page_margin"
                android:paddingBottom="@dimen/space_xl">

                <include
                    android:id="@+id/source"
                    layout="@layout/component_withdraw_source"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/settings_section_gap"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Widget.Numo.SettingsSectionTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginBottom="0dp"
                        android:labelFor="@id/to_input"
                        android:text="@string/withdraw_to_label" />

                    <Button
                        android:id="@+id/paste_button"
                        style="@style/Widget.Numo.Button.Tertiary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="-12dp"
                        android:minWidth="64dp"
                        android:minHeight="48dp"
                        android:text="@string/withdraw_paste"
                        android:textAppearance="@style/Text.Chip"
                        android:textColor="@color/text_button_primary" />

                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/to_layout"
                    style="@style/Widget.Numo.SettingsTextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    app:endIconContentDescription="@string/withdraw_to_scan"
                    app:endIconDrawable="@drawable/ic_qr_scan"
                    app:endIconMode="custom"
                    app:endIconTint="?attr/colorOnSurfaceVariant"
                    app:helperText="@string/withdraw_to_helper"
                    app:helperTextEnabled="true"
                    app:helperTextTextAppearance="@style/Text.SettingsCaption"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/to_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/withdraw_to_hint"
                        android:imeOptions="actionDone"
                        android:inputType="textNoSuggestions|textEmailAddress|textMultiLine"
                        android:maxLines="3"
                        android:minHeight="56dp"
                        android:textAppearance="@style/Text.SettingsInput"
                        android:textColorHint="?attr/colorOnSurfaceVariant" />

                </com.google.android.material.textfield.TextInputLayout>

                <include
                    android:id="@+id/amount"
                    layout="@layout/component_withdraw_amount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/settings_section_gap" />

            </LinearLayout>

        </ScrollView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/settings_page_margin"
            android:paddingTop="@dimen/space_m"
            android:paddingBottom="@dimen/space_l">

            <Button
                android:id="@+id/review_button"
                style="@style/Widget.Button.Primary.Green"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:enabled="false"
                android:text="@string/withdraw_review" />

        </FrameLayout>

    </LinearLayout>

</com.electricdreams.numo.ui.components.SettingsPageLayout>
