<?xml version="1.0" encoding="utf-8"?>
<com.electricdreams.numo.ui.components.SettingsPageLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top App Bar -->

        <com.electricdreams.numo.ui.components.NumoTopBar
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:topBarTitle="@string/settings_theme_title"
            app:layout_constraintTop_toTopOf="parent"
            android:minHeight="64dp"
            app:topBarSettingsStyle="true" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/top_bar"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/theme_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp"
                android:paddingHorizontal="16dp">

                <!-- Mode Section Header -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/theme_settings_section_mode"
                    android:textAppearance="@style/Text.SettingsSection"
                    android:textAllCaps="false"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="12dp"
                    android:accessibilityHeading="true" />

                <!-- Dark Mode Toggle -->

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/dark_mode_switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="72dp"
                    android:text="@string/theme_settings_dark_mode_label"
                    android:padding="16dp"
                    android:background="@drawable/bg_settings_group" />

                <!-- App Theme Section Header -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/theme_settings_section_app_theme"
                    android:textAppearance="@style/Text.SettingsSection"
                    android:textAllCaps="false"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="12dp"
                    android:accessibilityHeading="true" />

                <!-- Theme Radio Group -->

                <RadioGroup
                    android:id="@+id/theme_radio_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_settings_group"
                    android:clipToOutline="true"
                    android:divider="@drawable/settings_divider"
                    android:showDividers="middle">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/radio_obsidian"
                        android:text="@string/theme_settings_option_obsidian"
                        style="@style/Widget.Numo.SettingsChoice"
                        android:drawableEnd="@drawable/settings_swatch_obsidian" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/radio_bitcoin_orange"
                        android:text="@string/theme_settings_option_bitcoin_orange"
                        style="@style/Widget.Numo.SettingsChoice"
                        android:drawableEnd="@drawable/settings_swatch_bitcoin_orange" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/radio_green"
                        android:text="@string/theme_settings_option_green"
                        style="@style/Widget.Numo.SettingsChoice"
                        android:drawableEnd="@drawable/settings_swatch_green" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/radio_white"
                        android:text="@string/theme_settings_option_white"
                        style="@style/Widget.Numo.SettingsChoice"
                        android:drawableEnd="@drawable/settings_swatch_white" />

                </RadioGroup>

            </LinearLayout>

        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.electricdreams.numo.ui.components.SettingsPageLayout>
