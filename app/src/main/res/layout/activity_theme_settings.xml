<?xml version="1.0" encoding="utf-8"?>
<com.electricdreams.numo.ui.components.SettingsPageLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top App Bar -->

        <com.electricdreams.numo.ui.components.NumoTopBar
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:topBarTitle="@string/settings_theme_title"
            app:layout_constraintTop_toTopOf="parent"
            android:minHeight="64dp"
            app:topBarSettingsStyle="true" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/top_bar"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/theme_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp"
                android:paddingHorizontal="@dimen/settings_page_margin">

                <com.electricdreams.numo.ui.components.ThemePreviewView
                    android:id="@+id/theme_preview"
                    android:layout_width="match_parent"
                    android:layout_height="264dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_theme_preview"
                    android:contentDescription="@string/theme_settings_preview_description"
                    android:importantForAccessibility="yes" />

                <!-- Mode Section Header -->

                <TextView
                    android:text="@string/theme_settings_section_mode"
                    style="@style/Widget.Numo.SettingsSectionTitle"
                    android:textAllCaps="false"
                    android:layout_marginTop="@dimen/settings_section_gap"
                    android:accessibilityHeading="true" />

                <!-- Dark Mode Toggle -->

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/dark_mode_switch"
                    style="@style/Widget.Numo.SettingsSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/settings_switch_height"
                    android:text="@string/theme_settings_dark_mode_label"
                    android:textAppearance="@style/Text.RowTitle"
                    android:paddingHorizontal="0dp"
                    android:paddingVertical="@dimen/settings_row_padding"
                    android:background="@drawable/bg_settings_group" />

                <!-- App Theme Section Header -->

                <TextView
                    android:text="@string/theme_settings_section_app_theme"
                    style="@style/Widget.Numo.SettingsSectionTitle"
                    android:textAllCaps="false"
                    android:layout_marginTop="@dimen/settings_section_gap"
                    android:accessibilityHeading="true" />

                <!-- Theme Radio Group -->

                <RadioGroup
                    android:id="@+id/theme_radio_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_settings_group"
                    android:clipToOutline="true"
                    android:showDividers="none">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/radio_obsidian"
                        android:text="@string/theme_settings_option_obsidian"
                        style="@style/Widget.Numo.SettingsChoice" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/radio_bitcoin_orange"
                        android:text="@string/theme_settings_option_bitcoin_orange"
                        style="@style/Widget.Numo.SettingsChoice" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/radio_green"
                        android:text="@string/theme_settings_option_green"
                        style="@style/Widget.Numo.SettingsChoice" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/radio_white"
                        android:text="@string/theme_settings_option_white"
                        style="@style/Widget.Numo.SettingsChoice" />

                </RadioGroup>

            </LinearLayout>

        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.electricdreams.numo.ui.components.SettingsPageLayout>
