<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_white">

    <!-- Same bar as Activity and the details: a drill-in from Activity, so a back chevron -->
    <com.electricdreams.numo.ui.components.NumoTopBar
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_bar_height"
        app:topBarTitle="@string/insights_title"
        app:topBarActionIcon="@drawable/ic_tune"
        app:topBarActionContentDescription="@string/insights_view_options"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- The period's total, laid out like Activity's balance: label, amount, then a quiet line
         with the sale count and the tips, which are kept out of the total -->
    <LinearLayout
        android:id="@+id/stat_pair"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="@dimen/space_l"
        android:paddingBottom="@dimen/space_xl"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <TextView
            android:id="@+id/stat_label"
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Last 7 days" />

        <TextView
            android:id="@+id/stat_value"
            style="@style/Text.DisplayAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            tools:text="$846.61" />

        <TextView
            android:id="@+id/stat_secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/row_subtitle_gap"
            android:textAppearance="@style/Text.Body"
            android:textColor="@color/color_text_tertiary"
            tools:text="23 sales · $41.20 in tips" />

    </LinearLayout>

    <com.electricdreams.numo.feature.insights.InsightsBarChartView
        android:id="@+id/bar_chart"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        app:layout_constraintTop_toBottomOf="@id/stat_pair" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/transactions_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_l"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_xl"
        app:layout_constraintTop_toBottomOf="@id/bar_chart"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Activity's empty state, below the chart -->
    <include
        android:id="@+id/empty_view"
        layout="@layout/component_empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/bar_chart" />

</androidx.constraintlayout.widget.ConstraintLayout>
