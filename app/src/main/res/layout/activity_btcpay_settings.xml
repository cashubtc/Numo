<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_white">

    <com.electricdreams.numo.ui.components.NumoTopBar
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_bar_height"
        app:layout_constraintTop_toTopOf="parent"
        app:topBarTitle="@string/btcpay_settings_title" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_2xl">

            <LinearLayout
                android:id="@+id/enable_toggle_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:background="@drawable/bg_row_ripple"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/margin_screen_horizontal"
                android:paddingVertical="@dimen/row_padding_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/btcpay_enable_title"
                        android:textAppearance="@style/Text.RowTitle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/row_subtitle_gap"
                        android:text="@string/btcpay_enable_subtitle"
                        android:textAppearance="@style/Text.RowSubtitle" />

                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/btcpay_enable_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/margin_screen_horizontal"
                android:paddingTop="@dimen/section_gap"
                android:paddingBottom="@dimen/row_padding_vertical"
                android:text="@string/btcpay_section_connection"
                android:textAppearance="@style/Text.SectionHeader" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin_screen_horizontal"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_s"
                    android:text="@string/btcpay_server_url_label"
                    android:textAppearance="@style/Text.RowTitle" />

                <EditText
                    android:id="@+id/btcpay_server_url_input"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_outlined_input"
                    android:fontFamily="sans-serif"
                    android:hint="@string/btcpay_server_url_hint"
                    android:inputType="textUri"
                    android:paddingHorizontal="@dimen/space_l"
                    android:textColor="@color/color_text_primary"
                    android:textColorHint="@color/color_text_tertiary"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l"
                    android:layout_marginBottom="@dimen/space_s"
                    android:text="@string/btcpay_api_key_label"
                    android:textAppearance="@style/Text.RowTitle" />

                <EditText
                    android:id="@+id/btcpay_api_key_input"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_outlined_input"
                    android:fontFamily="sans-serif"
                    android:hint="@string/btcpay_api_key_hint"
                    android:inputType="textPassword"
                    android:paddingHorizontal="@dimen/space_l"
                    android:textColor="@color/color_text_primary"
                    android:textColorHint="@color/color_text_tertiary"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l"
                    android:layout_marginBottom="@dimen/space_s"
                    android:text="@string/btcpay_store_id_label"
                    android:textAppearance="@style/Text.RowTitle" />

                <EditText
                    android:id="@+id/btcpay_store_id_input"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_outlined_input"
                    android:fontFamily="sans-serif"
                    android:hint="@string/btcpay_store_id_hint"
                    android:inputType="text"
                    android:paddingHorizontal="@dimen/space_l"
                    android:textColor="@color/color_text_primary"
                    android:textColorHint="@color/color_text_tertiary"
                    android:textSize="16sp" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/margin_screen_horizontal"
                android:paddingTop="@dimen/section_gap"
                android:paddingBottom="@dimen/row_padding_vertical"
                android:text="@string/btcpay_section_test"
                android:textAppearance="@style/Text.SectionHeader" />

            <LinearLayout
                android:id="@+id/test_connection_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_row_ripple"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/margin_screen_horizontal"
                android:paddingVertical="@dimen/row_padding_vertical">

                <ImageView
                    android:layout_width="@dimen/icon_size_small"
                    android:layout_height="@dimen/icon_size_small"
                    android:layout_marginEnd="@dimen/row_icon_gap"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_link"
                    app:tint="@color/color_bitcoin_orange" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/btcpay_test_connection_title"
                        android:textAppearance="@style/Text.RowTitle" />

                    <TextView
                        android:id="@+id/test_connection_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/row_subtitle_gap"
                        android:text="@string/btcpay_test_connection_subtitle"
                        android:textAppearance="@style/Text.RowSubtitle" />

                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_forward"
                    app:tint="@color/color_text_tertiary" />

            </LinearLayout>

            <TextView
                android:id="@+id/pos_section_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/margin_screen_horizontal"
                android:paddingTop="@dimen/section_gap"
                android:paddingBottom="@dimen/row_padding_vertical"
                android:text="@string/btcpay_section_pos"
                android:textAppearance="@style/Text.SectionHeader"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/pos_app_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/pos_app_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_row_ripple"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/margin_screen_horizontal"
                    android:paddingVertical="@dimen/row_padding_vertical">

                    <ImageView
                        android:layout_width="@dimen/icon_size_small"
                        android:layout_height="@dimen/icon_size_small"
                        android:layout_marginEnd="@dimen/row_icon_gap"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_shopping_bag"
                        app:tint="@color/color_success_green" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/btcpay_pos_app_title"
                            android:textAppearance="@style/Text.RowTitle" />

                        <TextView
                            android:id="@+id/pos_app_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/row_subtitle_gap"
                            android:text="@string/btcpay_pos_app_subtitle_none"
                            android:textAppearance="@style/Text.RowSubtitle" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_forward"
                        app:tint="@color/color_text_tertiary" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
