<?xml version="1.0" encoding="utf-8"?>
<com.electricdreams.numo.ui.components.SettingsPageLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.electricdreams.numo.ui.components.NumoTopBar
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:topBarTitle="@string/btcpay_settings_title"
            android:minHeight="64dp"
            app:topBarSettingsStyle="true" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:fillViewport="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/top_bar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp"
                android:paddingHorizontal="@dimen/settings_page_margin">

                <LinearLayout
                    android:id="@+id/enable_toggle_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l"
                    android:background="@drawable/bg_settings_group"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:clipToOutline="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingHorizontal="0dp"
                    android:paddingVertical="@dimen/settings_row_padding"
                    android:minHeight="@dimen/settings_switch_height"
                    android:screenReaderFocusable="true">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/btcpay_enable_title"
                            android:textAppearance="@style/Text.RowTitle" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/settings_row_subtitle_gap"
                            android:text="@string/btcpay_enable_subtitle"
                            android:textAppearance="@style/Text.SettingsCaption" />

                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/btcpay_enable_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:contentDescription="@string/btcpay_enable_title" />

                </LinearLayout>

                <TextView
                    android:text="@string/btcpay_section_connection"
                    style="@style/Widget.Numo.SettingsSectionTitle"
                    android:textAllCaps="false"
                    android:layout_marginTop="@dimen/settings_section_gap"
                    android:accessibilityHeading="true" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_settings_group"
                    android:clipToOutline="true"
                    android:paddingHorizontal="0dp"
                    android:paddingVertical="@dimen/settings_row_padding">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Numo.SettingsTextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/btcpay_server_url_label"
                        android:layout_marginTop="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/btcpay_server_url_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:inputType="textUri"
                            android:textColor="@color/color_text_primary"
                            android:textColorHint="?attr/colorOnSurfaceVariant"
                            android:textAppearance="@style/Text.SettingsInput"
                            android:minHeight="56dp"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp"
                            android:padding="@dimen/settings_row_padding" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Numo.SettingsTextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/btcpay_api_key_label"
                        android:layout_marginTop="12dp"
                        app:endIconMode="password_toggle">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/btcpay_api_key_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:inputType="textPassword"
                            android:textColor="@color/color_text_primary"
                            android:textColorHint="?attr/colorOnSurfaceVariant"
                            android:textAppearance="@style/Text.SettingsInput"
                            android:minHeight="56dp"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp"
                            android:padding="@dimen/settings_row_padding" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Numo.SettingsTextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/btcpay_store_id_label"
                        android:layout_marginTop="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/btcpay_store_id_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:inputType="text"
                            android:textColor="@color/color_text_primary"
                            android:textColorHint="?attr/colorOnSurfaceVariant"
                            android:textAppearance="@style/Text.SettingsInput"
                            android:minHeight="56dp"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp"
                            android:padding="@dimen/settings_row_padding" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <TextView
                    android:text="@string/btcpay_section_test"
                    style="@style/Widget.Numo.SettingsSectionTitle"
                    android:textAllCaps="false"
                    android:layout_marginTop="@dimen/settings_section_gap"
                    android:accessibilityHeading="true" />

                <LinearLayout
                    android:id="@+id/test_connection_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_settings_group"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:clipToOutline="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingHorizontal="0dp"
                    android:paddingVertical="@dimen/settings_row_padding"
                    android:minHeight="@dimen/settings_switch_height"
                    android:screenReaderFocusable="true">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="@dimen/settings_row_icon_gap"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_link"
                        app:tint="?attr/colorPrimary"
                        android:padding="@dimen/settings_icon_padding" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/btcpay_test_connection_title"
                            android:textAppearance="@style/Text.RowTitle" />

                        <TextView
                            android:id="@+id/test_connection_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/settings_row_subtitle_gap"
                            android:text="@string/btcpay_test_connection_subtitle"
                            android:textAppearance="@style/Text.SettingsCaption" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_forward"
                        app:tint="@color/color_text_tertiary" />

                </LinearLayout>

                <TextView
                    android:id="@+id/pos_section_label"
                    android:text="@string/btcpay_section_pos"
                    style="@style/Widget.Numo.SettingsSectionTitle"
                    android:visibility="gone"
                    android:textAllCaps="false"
                    android:layout_marginTop="@dimen/settings_section_gap"
                    android:accessibilityHeading="true" />

                <LinearLayout
                    android:id="@+id/pos_app_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:background="@drawable/bg_settings_group"
                    android:clipToOutline="true"
                    android:padding="0dp"
                    android:minHeight="@dimen/settings_switch_height">

                    <LinearLayout
                        android:id="@+id/pos_app_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_row_ripple"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="0dp"
                        android:paddingVertical="@dimen/row_padding_vertical"
                        android:screenReaderFocusable="true">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="@dimen/settings_row_icon_gap"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_shopping_bag"
                            app:tint="?attr/colorPrimary"
                            android:padding="@dimen/settings_icon_padding" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/btcpay_pos_app_title"
                                android:textAppearance="@style/Text.RowTitle" />

                            <TextView
                                android:id="@+id/pos_app_subtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/settings_row_subtitle_gap"
                                android:text="@string/btcpay_pos_app_subtitle_none"
                                android:textAppearance="@style/Text.SettingsCaption" />

                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chevron_forward"
                            app:tint="@color/color_text_tertiary" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.electricdreams.numo.ui.components.SettingsPageLayout>
