<?xml version="1.0" encoding="utf-8"?>
<com.electricdreams.numo.ui.components.SettingsPageLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.electricdreams.numo.ui.components.NumoTopBar
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            app:layout_constraintTop_toTopOf="parent"
            app:topBarSettingsStyle="true"
            app:topBarTitle="@string/stripe_card_settings_title" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:fillViewport="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/top_bar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/settings_page_margin"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:id="@+id/enable_toggle_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l"
                    android:background="@drawable/bg_settings_group"
                    android:clickable="true"
                    android:clipToOutline="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/settings_switch_height"
                    android:orientation="horizontal"
                    android:paddingHorizontal="0dp"
                    android:paddingVertical="@dimen/settings_row_padding"
                    android:screenReaderFocusable="true">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/stripe_card_enable_title"
                            android:textAppearance="@style/Text.RowTitle" />

                        <TextView
                            android:id="@+id/enable_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/settings_row_subtitle_gap"
                            android:text="@string/stripe_card_enable_subtitle"
                            android:textAppearance="@style/Text.SettingsCaption" />

                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/stripe_card_enable_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/stripe_card_enable_title"
                        android:minHeight="48dp" />

                </LinearLayout>

                <TextView
                    style="@style/Widget.Numo.SettingsSectionTitle"
                    android:layout_marginTop="@dimen/settings_section_gap"
                    android:accessibilityHeading="true"
                    android:text="@string/stripe_card_section_account"
                    android:textAllCaps="false" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_settings_group"
                    android:clipToOutline="true"
                    android:orientation="vertical"
                    android:paddingHorizontal="0dp"
                    android:paddingVertical="@dimen/settings_row_padding">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/stripe_restricted_key_layout"
                        style="@style/Widget.Numo.SettingsTextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/stripe_card_restricted_key_label"
                        app:endIconMode="password_toggle">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/stripe_restricted_key_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:importantForAutofill="no"
                            android:inputType="textPassword"
                            android:minHeight="56dp"
                            android:padding="@dimen/settings_row_padding"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp"
                            android:textAppearance="@style/Text.SettingsInput"
                            android:textColor="@color/color_text_primary"
                            android:textColorHint="?attr/colorOnSurfaceVariant" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/stripe_location_layout"
                        style="@style/Widget.Numo.SettingsTextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/stripe_card_location_label">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/stripe_location_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:importantForAutofill="no"
                            android:inputType="text"
                            android:minHeight="56dp"
                            android:padding="@dimen/settings_row_padding"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp"
                            android:textAppearance="@style/Text.SettingsInput"
                            android:textColor="@color/color_text_primary"
                            android:textColorHint="?attr/colorOnSurfaceVariant" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/stripe_setup_help"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:text="@string/stripe_card_setup_help"
                        android:textAppearance="@style/Text.SettingsCaption" />

                </LinearLayout>

                <TextView
                    style="@style/Widget.Numo.SettingsSectionTitle"
                    android:layout_marginTop="@dimen/settings_section_gap"
                    android:accessibilityHeading="true"
                    android:text="@string/stripe_card_section_test"
                    android:textAllCaps="false" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_settings_group"
                    android:clipToOutline="true"
                    android:orientation="vertical"
                    android:padding="0dp">

                    <LinearLayout
                        android:id="@+id/test_connection_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_row_ripple"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/settings_switch_height"
                        android:orientation="horizontal"
                        android:paddingHorizontal="0dp"
                        android:paddingVertical="@dimen/settings_row_padding"
                        android:screenReaderFocusable="true">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="@dimen/settings_row_icon_gap"
                            android:importantForAccessibility="no"
                            android:padding="@dimen/settings_icon_padding"
                            android:src="@drawable/ic_link"
                            app:tint="?attr/colorPrimary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/stripe_card_test_title"
                                android:textAppearance="@style/Text.RowTitle" />

                            <TextView
                                android:id="@+id/test_connection_status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/settings_row_subtitle_gap"
                                android:text="@string/stripe_card_test_subtitle"
                                android:textAppearance="@style/Text.SettingsCaption" />

                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chevron_forward"
                            app:tint="@color/color_text_tertiary" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/remove_key_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_row_ripple"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/settings_switch_height"
                        android:orientation="horizontal"
                        android:paddingHorizontal="0dp"
                        android:paddingVertical="@dimen/settings_row_padding"
                        android:screenReaderFocusable="true">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="@dimen/settings_row_icon_gap"
                            android:importantForAccessibility="no"
                            android:padding="@dimen/settings_icon_padding"
                            android:src="@drawable/ic_trash"
                            app:tint="@color/color_error" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/stripe_card_remove_title"
                                android:textAppearance="@style/Text.RowTitle" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/settings_row_subtitle_gap"
                                android:text="@string/stripe_card_remove_subtitle"
                                android:textAppearance="@style/Text.SettingsCaption" />

                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chevron_forward"
                            app:tint="@color/color_text_tertiary" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.electricdreams.numo.ui.components.SettingsPageLayout>
