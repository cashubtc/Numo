<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/payment_request_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_white">

    <!-- Top Bar -->
    <ImageButton
        android:id="@+id/close_button"
        android:layout_width="@dimen/icon_size_large"
        android:layout_height="@dimen/icon_size_large"
        android:layout_marginStart="@dimen/space_l"
        android:layout_marginTop="@dimen/space_l"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_close"
        android:contentDescription="@string/payment_request_close_content_description"
        app:tint="@color/color_text_primary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/share_button"
        android:layout_width="@dimen/icon_size_large"
        android:layout_height="@dimen/icon_size_large"
        android:layout_marginEnd="@dimen/space_l"
        android:layout_marginTop="@dimen/space_l"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_share"
        android:contentDescription="@string/payment_request_share_content_description"
        app:tint="@color/color_text_primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Offline marker: lives in the header row instead of the app-wide strip, so the QR never
         moves while a customer may be scanning it -->
    <LinearLayout
        android:id="@+id/offline_pill"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/offline_pill_height"
        android:background="@drawable/bg_offline_pill"
        android:clickable="true"
        android:focusable="true"
        android:foreground="@drawable/bg_offline_strip_ripple"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_m"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/close_button"
        app:layout_constraintEnd_toStartOf="@id/share_button"
        app:layout_constraintStart_toEndOf="@id/close_button"
        app:layout_constraintTop_toTopOf="@id/close_button">

        <TextView
            android:id="@+id/offline_pill_text"
            style="@style/Text.OfflineStripTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/offline_strip_title"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Pay Label -->
    <TextView
        android:id="@+id/pay_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_xs"
        android:text="@string/payment_request_pay_label"
        android:textColor="@color/color_text_secondary"
        android:textSize="18sp"
        android:textStyle="normal"
        app:layout_constraintBottom_toTopOf="@id/large_amount_display"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/close_button" />

    <!-- Large Amount Display -->
    <TextView
        android:id="@+id/large_amount_display"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_xs"
        android:text="₿ 0"
        android:textColor="@color/color_text_primary"
        android:textSize="48sp"
        android:textStyle="bold"
        android:maxLines="1"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="24sp"
        app:autoSizeMaxTextSize="48sp"
        app:autoSizeStepGranularity="2sp"
        app:layout_constraintBottom_toTopOf="@id/converted_amount_display"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/pay_label" />

    <!-- Converted Amount Display -->
    <TextView
        android:id="@+id/converted_amount_display"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_xl"
        android:text=""
        android:textColor="@color/color_text_secondary"
        android:textSize="16sp"
        android:textStyle="normal"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/large_amount_display" />

    <!-- Tip Info Text (shown when tip was added) -->
    <TextView
        android:id="@+id/tip_info_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:text=""
        android:textColor="@color/color_success_green"
        android:textSize="14sp"
        android:textStyle="normal"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/qr_card"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/converted_amount_display" />

    <!-- QR Code Card -->
    <FrameLayout
        android:id="@+id/qr_card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_l"
        android:layout_marginHorizontal="@dimen/space_2xl"
        android:background="@drawable/bg_qr_card"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tip_info_text"
        app:layout_constraintBottom_toTopOf="@id/icons_container"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_bias="0.5">

        <FrameLayout
            android:id="@+id/lightning_qr_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/space_xl">

            <ImageView
                android:id="@+id/lightning_qr"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:visibility="invisible" />

            <!-- Loading spinner for Lightning invoice generation -->
            <ProgressBar
                android:id="@+id/lightning_loading_spinner"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:visibility="visible" />

            <!-- Center Logo Overlay for Lightning -->
            <androidx.cardview.widget.CardView
                android:id="@+id/lightning_logo_card"
                android:layout_width="@dimen/icon_size_large"
                android:layout_height="@dimen/icon_size_large"
                android:layout_gravity="center"
                app:cardBackgroundColor="@color/color_bg_white"
                app:cardCornerRadius="@dimen/radius_m"
                app:cardElevation="0dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_lightning_black"
                    app:tint="@color/color_text_primary" />
            </androidx.cardview.widget.CardView>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/cashu_qr_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/space_xl"
            android:visibility="visible">

            <ImageView
                android:id="@+id/payment_request_qr"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:visibility="invisible" />
                
            <!-- Loading spinner for Cashu payment request generation -->
            <ProgressBar
                android:id="@+id/cashu_loading_spinner"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:visibility="visible" />

            <!-- Center Logo Overlay for Cashu -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cashu_logo_card"
                android:layout_width="@dimen/icon_size_large"
                android:layout_height="@dimen/icon_size_large"
                android:layout_gravity="center"
                app:cardBackgroundColor="@color/color_bg_white"
                app:cardCornerRadius="@dimen/radius_m"
                app:cardElevation="0dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@drawable/cashu" />
            </androidx.cardview.widget.CardView>
        </FrameLayout>
        
        <FrameLayout
            android:id="@+id/unified_qr_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/space_xl"
            android:visibility="invisible">

            <ImageView
                android:id="@+id/unified_qr"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:visibility="invisible" />

            <!-- Loading spinner for Unified QR generation (waiting for both Cashu and Lightning) -->
            <ProgressBar
                android:id="@+id/unified_loading_spinner"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:visibility="visible" />
        </FrameLayout>
    </FrameLayout>


    <!-- Icons and Instruction -->
    <LinearLayout
        android:id="@+id/icons_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/qr_card">

        <ImageView
            android:id="@+id/contactless_icon"
            android:layout_width="@dimen/icon_size_small"
            android:layout_height="@dimen/icon_size_small"
            android:importantForAccessibility="no"
            android:src="@drawable/contactless"
            android:rotation="270"
            app:tint="@color/color_text_primary" />

        <TextView
            android:id="@+id/instruction_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:text="@string/payment_request_instruction_scan_or_tap"
            android:textColor="@color/color_text_primary"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center" />
    </LinearLayout>

    <!-- Status Text (Hidden) -->
    <TextView
        android:id="@+id/payment_status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:layout_marginHorizontal="@dimen/space_2xl"
        android:layout_marginTop="@dimen/space_s"
        android:breakStrategy="balanced"
        android:gravity="center"
        app:layout_constrainedWidth="true"
        android:text="@string/payment_request_status_waiting_for_payment"
        android:textColor="@color/color_text_secondary"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/icons_container" />


    <!-- Card payment (Stripe Tap to Pay). Shown only when card payments are set up.
         Both views are pinned to the bottom so nothing above can move them. -->
    <TextView
        android:id="@+id/card_message_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_2xl"
        android:layout_marginBottom="@dimen/space_m"
        android:accessibilityLiveRegion="polite"
        android:breakStrategy="balanced"
        android:ellipsize="end"
        android:gravity="bottom|center_horizontal"
        android:maxLines="4"
        android:minLines="2"
        android:textColor="@color/color_text_secondary"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/card_pay_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/card_pay_button"
        style="@style/Widget.Numo.Button.CardPay"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_height"
        android:layout_marginHorizontal="@dimen/space_2xl"
        android:layout_marginBottom="@dimen/space_xl"
        android:text="@string/card_payment_button"
        android:visibility="gone"
        app:icon="@drawable/ic_card"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />


    <!-- NFC Animation Overlay (Native View) - ONLY for NFC payments -->
    <FrameLayout
        android:id="@+id/nfc_animation_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_nfc_idle"
        android:clickable="true"
        android:focusable="true"
        android:fitsSystemWindows="false"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.electricdreams.numo.ui.animation.NfcPaymentAnimationView
            android:id="@+id/nfc_animation_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent" />

        <TextView
            android:id="@+id/animation_result_amount"
            android:accessibilityLiveRegion="polite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|center_vertical"
            android:layout_marginStart="@dimen/space_xl"
            android:layout_marginEnd="@dimen/space_xl"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:gravity="center"
            android:letterSpacing="-0.02"
            android:maxLines="1"
            android:textAlignment="center"
            android:translationY="-180dp"
            android:textColor="@android:color/white"
            android:textSize="56sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/animation_result_label"
            android:accessibilityLiveRegion="polite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|center_vertical"
            android:layout_marginStart="@dimen/space_2xl"
            android:layout_marginEnd="@dimen/space_2xl"
            android:gravity="center"
            android:maxLines="3"
            android:textAlignment="center"
            android:translationY="-120dp"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:visibility="gone" />

        <!-- The amount stays in view while waiting, where the card tap screen shows its total -->
        <LinearLayout
            android:id="@+id/animation_total_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginStart="@dimen/space_xl"
            android:layout_marginEnd="@dimen/space_xl"
            android:layout_marginBottom="@dimen/space_l"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semi_bold"
                android:text="@string/basket_archive_total_label"
                android:textColor="@color/color_text_secondary"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/animation_total_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:autoSizeMaxTextSize="68sp"
                app:autoSizeMinTextSize="28sp"
                app:autoSizeTextType="uniform"
                android:fontFamily="@font/inter_semi_bold"
                android:gravity="center"
                android:letterSpacing="-0.06"
                android:maxLines="1"
                android:textColor="@color/color_text_primary"
                android:textSize="68sp" />
        </LinearLayout>

        <!-- Result action buttons appear after animation completes -->
        <LinearLayout
            android:id="@+id/animation_actions_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginStart="@dimen/space_xl"
            android:layout_marginEnd="@dimen/space_xl"
            android:layout_marginBottom="@dimen/space_xl"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/animation_view_details_button"
                style="@style/Widget.Numo.Button.OnColor.Text"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/payment_received_button_view_details"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/animation_close_button"
                style="@style/Widget.Numo.Button.OnColor.Filled"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/payment_request_animation_close" />
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
