<?xml version="1.0" encoding="utf-8"?>
<com.electricdreams.numo.ui.components.SettingsPageLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top App Bar -->

        <com.electricdreams.numo.ui.components.NumoTopBar
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:topBarTitle="@string/language_settings_title"
            app:layout_constraintTop_toTopOf="parent"
            android:minHeight="64dp"
            app:topBarSettingsStyle="true" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/top_bar"
            app:layout_constraintBottom_toBottomOf="parent"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/language_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp"
                android:paddingHorizontal="@dimen/settings_page_margin">

                <!-- Section Header -->

                <TextView
                    android:text="@string/language_settings_section_app_language"
                    style="@style/Widget.Numo.SettingsSectionTitle"
                    android:textAllCaps="false"
                    android:layout_marginTop="@dimen/settings_section_gap"
                    android:accessibilityHeading="true" />

                <!-- Language Radio Group -->

                <RadioGroup
                    android:id="@+id/language_radio_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_settings_group"
                    android:clipToOutline="true"
                    android:showDividers="none">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/radio_english"
                        android:text="@string/language_settings_option_english"
                        style="@style/Widget.Numo.SettingsChoice" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/radio_german"
                        android:text="@string/language_settings_option_german"
                        style="@style/Widget.Numo.SettingsChoice" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/radio_spanish"
                        android:text="@string/language_settings_option_spanish"
                        style="@style/Widget.Numo.SettingsChoice" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/radio_portuguese"
                        android:text="@string/language_settings_option_portuguese"
                        style="@style/Widget.Numo.SettingsChoice" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/radio_korean"
                        android:text="@string/language_settings_option_korean"
                        style="@style/Widget.Numo.SettingsChoice" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/radio_japanese"
                        android:text="@string/language_settings_option_japanese"
                        style="@style/Widget.Numo.SettingsChoice" />

                </RadioGroup>

                <!-- Current language summary -->

                <TextView
                    android:id="@+id/current_language_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="0dp"
                    android:paddingTop="@dimen/space_l"
                    android:textAppearance="@style/Text.SettingsBody"
                    android:textColor="?attr/colorOnSurfaceVariant" />

            </LinearLayout>

        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.electricdreams.numo.ui.components.SettingsPageLayout>
