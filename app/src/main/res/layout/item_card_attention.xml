<?xml version="1.0" encoding="utf-8"?>
<!-- One thing that stops card payments, with the button that fixes it -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Numo.SettingsCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_m"
    app:cardBackgroundColor="@color/color_bg_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="@dimen/space_m"
        android:paddingBottom="@dimen/space_s">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_warning"
            app:tint="@color/color_warning" />

        <TextView
            android:id="@+id/attention_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:layout_marginEnd="@dimen/space_s"
            android:accessibilityHeading="true"
            android:fontFamily="sans-serif"
            android:lineHeight="26sp"
            android:textColor="@color/color_text_primary"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/attention_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:layout_marginEnd="@dimen/space_s"
            android:textAppearance="@style/Text.SettingsCaption" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/attention_fix_button"
            style="@style/Widget.Numo.Button.Tertiary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/space_xs"
            android:minHeight="48dp"
            android:textColor="@color/color_warning" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
