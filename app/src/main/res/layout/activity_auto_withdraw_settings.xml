<?xml version="1.0" encoding="utf-8"?>
<com.electricdreams.numo.ui.components.SettingsPageLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".feature.autowithdraw.AutoWithdrawSettingsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.electricdreams.numo.ui.components.NumoTopBar
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:topBarSettingsStyle="true"
            app:topBarTitle="@string/withdraw_hub_auto_title" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/settings_page_margin"
                android:paddingBottom="@dimen/space_xl">

                <!-- The rule is explained once, right where it is switched on. -->
                <LinearLayout
                    android:id="@+id/enable_toggle_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:background="@drawable/bg_row_ripple"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/settings_switch_height"
                    android:orientation="horizontal"
                    android:paddingVertical="@dimen/settings_row_padding">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_l"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/withdraw_hub_auto_title"
                            android:textAppearance="@style/Text.RowTitle" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/settings_row_subtitle_gap"
                            android:text="@string/withdraw_auto_subtitle"
                            android:textAppearance="@style/Text.SettingsCaption" />

                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/enable_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false"
                        android:importantForAccessibility="no"
                        android:minHeight="48dp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/auto_withdraw_config_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        style="@style/Widget.Numo.SettingsSectionTitle"
                        android:layout_marginTop="@dimen/settings_section_gap"
                        android:labelFor="@id/lightning_address_input"
                        android:text="@string/withdraw_auto_section_destination" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/lightning_address_layout"
                        style="@style/Widget.Numo.SettingsTextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:helperTextEnabled="true"
                        app:helperTextTextAppearance="@style/Text.SettingsCaption"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/lightning_address_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/auto_withdraw_lightning_address_hint"
                            android:imeOptions="actionDone"
                            android:inputType="textEmailAddress|textNoSuggestions"
                            android:minHeight="56dp"
                            android:textAppearance="@style/Text.SettingsInput"
                            android:textColorHint="?attr/colorOnSurfaceVariant" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        style="@style/Widget.Numo.SettingsSectionTitle"
                        android:layout_marginTop="@dimen/settings_section_gap"
                        android:layout_marginBottom="0dp"
                        android:text="@string/withdraw_auto_section_rule" />

                    <com.electricdreams.numo.ui.components.SettingsRowView
                        android:id="@+id/threshold_row"
                        style="@style/Widget.Numo.SettingsRow"
                        android:minHeight="@dimen/settings_row_height"
                        app:rowShowChevron="true"
                        app:rowTitle="@string/withdraw_auto_threshold_title" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/settings_row_height"
                        android:orientation="horizontal"
                        android:paddingTop="@dimen/settings_row_padding">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/space_l"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:labelFor="@id/percentage_slider"
                                android:text="@string/withdraw_auto_percentage_title"
                                android:textAppearance="@style/Text.RowTitle" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/settings_row_subtitle_gap"
                                android:text="@string/withdraw_auto_percentage_subtitle"
                                android:textAppearance="@style/Text.SettingsCaption" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/percentage_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="48dp"
                            android:gravity="end"
                            android:importantForAccessibility="no"
                            android:textAppearance="@style/Text.RowTitle"
                            tools:text="95%" />

                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/percentage_slider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="-16dp"
                        android:stepSize="1"
                        android:valueFrom="50"
                        android:valueTo="98"
                        app:haloColor="@color/color_ripple"
                        app:labelBehavior="gone"
                        app:thumbColor="@color/color_brand_foreground"
                        app:tickVisible="false"
                        app:trackColorActive="@color/color_brand_foreground"
                        app:trackColorInactive="@color/color_bg_tertiary" />

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

</com.electricdreams.numo.ui.components.SettingsPageLayout>
