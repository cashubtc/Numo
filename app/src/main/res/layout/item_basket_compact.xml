<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/space_l"
    android:paddingVertical="@dimen/space_m"
    android:background="?attr/selectableItemBackground">

    <!-- Quantity Badge -->
    <TextView
        android:id="@+id/item_quantity_badge"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/bg_notification_dot"
        android:backgroundTint="@color/color_text_primary"
        android:gravity="center"
        android:textAppearance="@style/Text.Badge"
        android:textColor="@color/color_bg_white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:text="2" />

    <!-- Item Name and Variation -->
    <LinearLayout
        android:id="@+id/text_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_m"
        android:layout_marginEnd="@dimen/space_m"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/item_total"
        app:layout_constraintStart_toEndOf="@id/item_quantity_badge"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/item_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            style="@style/Text.RowTitle"
            tools:text="Classic T-Shirt" />

        <TextView
            android:id="@+id/item_variation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            style="@style/Text.RowSubtitle"
            android:visibility="gone"
            tools:text="Medium / Navy Blue"
            tools:visibility="visible" />

    </LinearLayout>

    <!-- Preserve upstream's trailing price column; limit long custom amounts to half the row. -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/price_start_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <TextView
        android:id="@+id/item_total"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textAppearance="@style/Text.Body"
        app:layout_constrainedWidth="true"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="@id/price_start_guideline"
        app:layout_constraintEnd_toStartOf="@id/remove_button"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:text="$49.98" />

    <!-- Remove Button -->
    <ImageButton
        android:id="@+id/remove_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="@dimen/space_s"
        android:padding="@dimen/space_s"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/desc_remove_item"
        android:src="@drawable/ic_close"
        app:tint="@color/color_icon_tertiary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
