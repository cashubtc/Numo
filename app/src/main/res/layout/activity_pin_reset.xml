<?xml version="1.0" encoding="utf-8"?>
<com.electricdreams.numo.ui.components.SettingsPageLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top App Bar -->

        <com.electricdreams.numo.ui.components.NumoTopBar
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            app:topBarSettingsStyle="true"
            app:topBarTitle="@string/pin_reset_title"
            app:layout_constraintTop_toTopOf="parent" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/top_bar"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/settings_page_margin"
                android:paddingBottom="24dp">

                <!-- Warning Card -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="@drawable/bg_settings_warning">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="@dimen/icon_size_small"
                            android:layout_height="@dimen/icon_size_small"
                            android:layout_marginEnd="@dimen/space_m"
                            android:src="@drawable/ic_warning"
                            app:tint="@color/color_warning"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/pin_reset_warning_title"
                            android:textSize="@dimen/text_button"
                            android:textColor="@color/color_text_primary"
                            android:fontFamily="sans-serif-medium" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:text="@string/pin_reset_warning_message"
                        android:textSize="@dimen/text_chip"
                        android:textColor="@color/color_text_secondary"
                        android:lineSpacingMultiplier="1.3" />

                </LinearLayout>

                <!-- Seed Phrase Title -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:layout_marginBottom="16dp"
                    android:text="@string/pin_reset_recovery_phrase"
                    android:textSize="15sp"
                    android:textColor="@color/color_text_secondary"
                    android:fontFamily="sans-serif-medium" />

                <!-- Seed Input Grid -->

                <androidx.gridlayout.widget.GridLayout
                    android:id="@+id/seed_input_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:columnCount="2"
                    app:rowCount="6"
                    app:useDefaultMargins="false" />

                <!-- Paste Button -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/paste_button"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:text="@string/pin_reset_paste_clipboard"
                    android:textSize="14sp"
                    android:textColor="@color/color_text_primary"
                    app:icon="@drawable/ic_content_copy"
                    app:iconTint="@color/color_text_primary"
                    app:iconPadding="8dp"
                    app:strokeColor="@color/color_divider"
                    app:cornerRadius="22dp"
                    android:minHeight="56dp" />

                <!-- Validation Status -->

                <LinearLayout
                    android:id="@+id/validation_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/validation_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="8dp"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/validation_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp" />

                </LinearLayout>

                <!-- Reset Button -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/reset_button"
                    style="@style/Widget.Numo.Button.Dialog.Destructive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xl"
                    android:text="@string/pin_reset_button"
                    android:enabled="false"
                    android:alpha="0.5"
                    android:minHeight="56dp" />

            </LinearLayout>

        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.electricdreams.numo.ui.components.SettingsPageLayout>
