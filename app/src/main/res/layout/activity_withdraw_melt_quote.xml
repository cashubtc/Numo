<?xml version="1.0" encoding="utf-8"?>
<com.electricdreams.numo.ui.components.SettingsPageLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".feature.settings.WithdrawMeltQuoteActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.electricdreams.numo.ui.components.NumoTopBar
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:topBarSettingsStyle="true"
            app:topBarTitle="@string/withdraw_review_title" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/settings_page_margin"
                android:paddingBottom="@dimen/space_xl">

                <TextView
                    android:id="@+id/amount_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3xl"
                    android:textAppearance="@style/Text.DisplayAmount"
                    tools:text="20 sat" />

                <TextView
                    android:id="@+id/fiat_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:textAppearance="@style/Text.AmountSubtitle"
                    tools:text="$0.02" />

                <TextView
                    android:id="@+id/destination_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:ellipsize="middle"
                    android:gravity="center"
                    android:singleLine="true"
                    android:textAppearance="@style/Text.Body"
                    tools:text="to shop@wallet.com" />

                <!-- Failure or pending explanation, shown in place of a toast. -->
                <LinearLayout
                    android:id="@+id/status_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2xl"
                    android:accessibilityLiveRegion="polite"
                    android:background="@drawable/bg_withdraw_banner"
                    android:backgroundTint="@color/color_status_error_bg"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_l"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:id="@+id/status_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginTop="1dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_warning"
                        app:tint="@color/m3_error" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_m"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/status_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/Text.BodyBold"
                            tools:text="@string/withdraw_failed_title" />

                        <TextView
                            android:id="@+id/status_body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:textAppearance="@style/Text.SettingsCaption"
                            android:textColor="@color/color_text_primary"
                            tools:text="@string/withdraw_failed_body" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2xl"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/settings_row_height"
                        android:orientation="horizontal"
                        android:screenReaderFocusable="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/withdraw_row_from"
                            android:textAppearance="@style/Text.Body" />

                        <TextView
                            android:id="@+id/from_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_l"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:gravity="end"
                            android:singleLine="true"
                            android:textAppearance="@style/Text.BodyBold"
                            tools:text="Minibits" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/color_divider" />

                    <LinearLayout
                        android:id="@+id/invoice_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:minHeight="@dimen/settings_row_height"
                            android:orientation="horizontal"
                            android:screenReaderFocusable="true">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/withdraw_row_to"
                                android:textAppearance="@style/Text.Body" />

                            <TextView
                                android:id="@+id/invoice_value"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_l"
                                android:layout_weight="1"
                                android:ellipsize="middle"
                                android:fontFamily="monospace"
                                android:gravity="end"
                                android:singleLine="true"
                                android:textAppearance="@style/Text.BodyBold"
                                tools:text="lnbc2500u1pvjluez…h2rspfj9srp" />

                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/color_divider" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/settings_row_height"
                        android:orientation="horizontal"
                        android:paddingVertical="@dimen/space_m"
                        android:screenReaderFocusable="true">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/withdraw_row_fee"
                                android:textAppearance="@style/Text.Body" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/settings_row_subtitle_gap"
                                android:text="@string/withdraw_row_fee_note"
                                android:textAppearance="@style/Text.SettingsCaption" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/fee_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_l"
                            android:textAppearance="@style/Text.BodyBold"
                            tools:text="Up to 1 sat" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/color_divider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/settings_row_height"
                        android:orientation="horizontal"
                        android:screenReaderFocusable="true">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/withdraw_row_total"
                            android:textAppearance="@style/Text.BodyBold" />

                        <TextView
                            android:id="@+id/total_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/Text.BodyBold"
                            tools:text="21 sat" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/settings_page_margin"
            android:paddingTop="@dimen/space_m"
            android:paddingBottom="@dimen/space_l">

            <Button
                android:id="@+id/send_button"
                style="@style/Widget.Button.Primary.Green"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                tools:text="Send 20 sat" />

            <Button
                android:id="@+id/secondary_button"
                style="@style/Widget.Numo.Button.Tertiary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/withdraw_change_destination"
                android:textAppearance="@style/Text.Button"
                android:textColor="@color/text_button_primary"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</com.electricdreams.numo.ui.components.SettingsPageLayout>
