<?xml version="1.0" encoding="utf-8"?>
<com.electricdreams.numo.ui.components.SettingsPageLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top Bar -->

        <com.electricdreams.numo.ui.components.NumoTopBar
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:topBarTitle="@string/basket_names_settings_title"
            app:layout_constraintTop_toTopOf="parent"
            android:minHeight="64dp"
            app:topBarSettingsStyle="true" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintTop_toBottomOf="@id/top_bar"
            app:layout_constraintBottom_toBottomOf="parent"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp"
                android:paddingHorizontal="16dp">

                <!-- Hero Section -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/margin_screen_horizontal"
                    android:paddingBottom="@dimen/margin_screen_horizontal">

                    <!-- Description -->

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/basket_names_settings_description"
                        android:textAppearance="@style/Text.SettingsCaption"
                        android:lineSpacingMultiplier="1.3" />

                </LinearLayout>

                <!-- Names List Container -->

                <LinearLayout
                    android:id="@+id/names_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Section Header -->

                    <TextView
                        android:id="@+id/names_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/basket_names_settings_presets_header"
                        android:textAppearance="@style/Text.SettingsSection"
                        android:visibility="gone"
                        tools:visibility="visible"
                        android:textAllCaps="false"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginTop="24dp"
                        android:layout_marginBottom="12dp"
                        android:accessibilityHeading="true" />

                    <!-- Names List -->

                    <LinearLayout
                        android:id="@+id/names_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:visibility="visible"
                        android:background="@drawable/bg_settings_group"
                        android:clipToOutline="true">

                        <LinearLayout
                            android:id="@+id/names_list"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                    </LinearLayout>

                    <!-- Empty State -->

                    <include
                        android:id="@+id/empty_state"
                        layout="@layout/component_settings_empty_state" />

                </LinearLayout>

                <!-- Add Name Button -->

                <Button
                    android:id="@+id/add_name_button"
                    style="@style/Widget.Button.Secondary.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/basket_names_settings_add_name"
                    android:drawableStart="@drawable/ic_add"
                    android:drawablePadding="@dimen/space_s" />

                <!-- Example suggestions -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xl"
                    android:paddingHorizontal="@dimen/margin_screen_horizontal"
                    android:text="@string/basket_names_settings_examples"
                    android:textAppearance="@style/Text.SettingsCaption"
                    android:lineSpacingMultiplier="1.4" />

                <!-- Clear All Button (only shown when items exist) -->

                <LinearLayout
                    android:id="@+id/clear_all_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2xl"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"
                    android:visibility="gone"
                    tools:visibility="visible"
                    android:minHeight="64dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:screenReaderFocusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/basket_names_settings_clear_all"
                        android:textAppearance="@style/Text.Link"
                        android:textColor="@color/color_warning_red" />

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.electricdreams.numo.ui.components.SettingsPageLayout>
