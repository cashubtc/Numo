<?xml version="1.0" encoding="utf-8"?>
<com.electricdreams.numo.ui.components.SettingsPageLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top Bar -->

        <com.electricdreams.numo.ui.components.NumoTopBar
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:topBarTitle="@string/mints_explore_title"
            app:topBarActionIcon="@drawable/ic_more_vert"
            app:topBarActionContentDescription="@string/mints_more_options"
            app:topBarActionTint="@color/color_text_primary"
            app:layout_constraintTop_toTopOf="parent"
            android:minHeight="64dp"
            app:topBarSettingsStyle="true" />

        <!-- Scrollable Content -->

        <ScrollView
            android:id="@+id/mints_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:fillViewport="true"
            app:layout_constraintTop_toBottomOf="@id/top_bar"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:id="@+id/mints_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp"
                android:paddingHorizontal="@dimen/settings_page_margin">

                <!-- ==================== -->

                <!-- LIGHTNING MINT SECTION -->

                <!-- ==================== -->

                <LinearLayout
                    android:id="@+id/lightning_mint_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Section Header -->

                    <TextView
                        android:text="@string/mints_lightning_mint"
                        style="@style/Widget.Numo.SettingsSectionTitle"
                        android:textAllCaps="false"
                        android:layout_marginTop="@dimen/settings_section_gap"
                        android:accessibilityHeading="true" />

                    <!-- Lightning Mint (plain, no surrounding card) -->

                    <LinearLayout
                        android:id="@+id/lightning_mint_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="0dp"
                        android:orientation="vertical"
                        android:paddingHorizontal="0dp"
                        android:paddingVertical="0dp"
                        android:clipChildren="false">

                        <com.electricdreams.numo.ui.components.MintListItem
                            android:id="@+id/lightning_mint_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <!-- Active Unit Row -->

                        <LinearLayout
                            android:id="@+id/active_unit_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingVertical="@dimen/settings_row_padding"
                            android:minHeight="48dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:screenReaderFocusable="true">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/mints_base_currency_unit_title"
                                    style="@style/Text.RowTitle" />

                            </LinearLayout>

                            <TextView
                                android:id="@+id/active_unit_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="@dimen/space_s"
                                android:text="sat"
                                android:textAppearance="@style/Text.SettingsCaption"
                                android:textColor="@color/color_text_primary" />

                            <ImageView
                                android:importantForAccessibility="no"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_chevron_right"
                                app:tint="@color/color_icon_secondary" />

                        </LinearLayout>

                        <!-- Swap-to-Lightning-mint option -->

                        <LinearLayout
                            android:id="@+id/swap_unknown_mints_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/swap_unknown_mints_switch"
                                style="@style/Widget.Numo.SettingsSwitch"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/mints_swap_unknown_mints_title" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/mints_swap_unknown_mints_subtitle"
                                android:textAppearance="@style/Text.SettingsCaption" />
                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <!-- ==================== -->

                <!-- ALL MINTS SECTION -->

                <!-- ==================== -->

                <TextView
                    android:id="@+id/all_mints_header"
                    android:text="@string/mints_other_mints"
                    style="@style/Widget.Numo.SettingsSectionTitle"
                    android:textAllCaps="false"
                    android:layout_marginTop="@dimen/settings_section_gap"
                    android:accessibilityHeading="true" />

                <!-- Mint List Container (plain, no surrounding card) -->

                <LinearLayout
                    android:id="@+id/mints_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_settings_group"
                    android:clipToOutline="true" />

                <!-- Empty State -->

                <LinearLayout
                    android:id="@+id/empty_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingVertical="@dimen/space_3xl"
                    android:visibility="gone">

                    <ImageView
                        android:importantForAccessibility="no"
                        android:layout_width="@dimen/icon_size_hero"
                        android:layout_height="@dimen/settings_item_height"
                        android:alpha="0.3"
                        android:src="@drawable/ic_bitcoin"
                        app:tint="@color/color_text_secondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_l"
                        android:text="@string/mints_empty_title"
                        android:textAppearance="@style/Text.RowTitle"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/mints_empty_subtitle"
                        android:textAppearance="@style/Text.SettingsCaption" />

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/add_mint_button"
                    style="@style/Widget.Numo.SettingsAddButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/section_gap"
                    android:gravity="center"
                    android:text="@string/mints_add_button" />

            </LinearLayout>

        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.electricdreams.numo.ui.components.SettingsPageLayout>
