<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingVertical="@dimen/space_3xl"
    android:paddingHorizontal="@dimen/space_xl"
    android:background="@drawable/bg_settings_group"
    android:padding="24dp">

    <!-- Rounded square icon container -->

    <FrameLayout
        android:layout_width="@dimen/icon_size_hero"
        android:layout_height="@dimen/top_bar_height"
        android:background="@drawable/bg_settings_icon">

        <ImageView
            android:id="@+id/empty_state_icon"
            android:importantForAccessibility="no"
            android:layout_width="@dimen/icon_size_small"
            android:layout_height="@dimen/icon_size_small"
            android:layout_gravity="center"
            app:tint="?attr/colorPrimary" />

    </FrameLayout>

    <!-- Title -->

    <TextView
        android:id="@+id/empty_state_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        style="@style/Text.RowTitle"
        android:gravity="center"
        android:letterSpacing="-0.012" />

    <!-- Description -->

    <TextView
        android:id="@+id/empty_state_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        style="@style/Text.SettingsBody"
        android:gravity="center"
        android:lineSpacingMultiplier="1.15" />

    <!-- Optional action button (hidden by default) -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/empty_state_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_screen_horizontal"
        android:drawablePadding="@dimen/space_s"
        android:gravity="center"
        android:visibility="gone"
        style="@style/Widget.Button.Primary.Green"
        android:minHeight="56dp" />

</LinearLayout>
