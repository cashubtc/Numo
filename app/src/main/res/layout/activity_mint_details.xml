<?xml version="1.0" encoding="utf-8"?>
<com.electricdreams.numo.ui.components.SettingsPageLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.electricdreams.numo.ui.components.NumoTopBar
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:topBarTitle="@string/mint_details_title"
            app:layout_constraintTop_toTopOf="parent"
            android:minHeight="64dp"
            app:topBarSettingsStyle="true" />
        <ScrollView
            android:id="@+id/scroll_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintTop_toBottomOf="@id/top_bar"
            app:layout_constraintBottom_toBottomOf="parent"
            android:clipToPadding="false">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp"
                android:paddingHorizontal="@dimen/settings_page_margin">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="@dimen/settings_row_padding"
                    android:layout_marginTop="@dimen/space_l">
                    <FrameLayout
                        android:id="@+id/icon_container"
                        android:layout_width="@dimen/settings_row_icon_size"
                        android:layout_height="@dimen/settings_row_icon_size"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="@color/color_bg_tertiary"
                        android:layout_marginEnd="@dimen/settings_row_icon_gap">
                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/mint_icon"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Circle"
                            app:strokeColor="@color/color_bg_white"
                            app:strokeWidth="2dp"
                            android:src="@drawable/ic_bitcoin"
                            android:importantForAccessibility="no" />
                    </FrameLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/mint_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/Text.RowTitle" />
                        <TextView
                            android:id="@+id/mint_url"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/settings_row_subtitle_gap"
                            android:textAppearance="@style/Text.SettingsCaption" />
                        <TextView
                            android:id="@+id/balance_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/settings_row_subtitle_gap"
                            android:textAppearance="@style/Text.SettingsCaption" />
                        <LinearLayout
                            android:id="@+id/lightning_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:visibility="gone">
                            <ImageView
                                android:importantForAccessibility="no"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginEnd="@dimen/space_s"
                                android:src="@drawable/ic_lightning_bolt"
                                app:tint="?attr/colorOnSurfaceVariant" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/mints_lightning_mint"
                                android:textAppearance="@style/Text.SettingsCaption"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/error_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="0dp"
                    android:paddingVertical="@dimen/space_s"
                    android:visibility="gone"
                    android:accessibilityLiveRegion="polite">
                    <ImageView
                        android:importantForAccessibility="no"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="@dimen/space_m"
                        android:src="@drawable/ic_warning"
                        app:tint="?attr/colorOnSurfaceVariant" />
                    <TextView
                        android:id="@+id/error_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/mint_details_fetch_error"
                        android:textAppearance="@style/Text.SettingsCaption"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/error_retry_button"
                        android:textAllCaps="false"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:minHeight="48dp"
                        android:text="@string/common_retry" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/description_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginTop="@dimen/settings_section_gap">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/Text.SettingsSection"
                        android:text="@string/mint_details_about"
                        android:textAllCaps="false"
                        android:layout_marginTop="0dp"
                        android:layout_marginBottom="12dp"
                        android:accessibilityHeading="true" />
                    <TextView
                        android:id="@+id/description_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textAppearance="@style/Text.SettingsBody" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/motd_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginTop="@dimen/settings_section_gap">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/Text.SettingsSection"
                        android:text="@string/mint_details_announcement"
                        android:textAllCaps="false"
                        android:layout_marginTop="0dp"
                        android:layout_marginBottom="12dp"
                        android:accessibilityHeading="true" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:id="@+id/motd_text"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAppearance="@style/Text.SettingsBody"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/details_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="@dimen/settings_section_gap">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/Text.SettingsSection"
                        android:text="@string/mint_details_details"
                        android:textAllCaps="false"
                        android:layout_marginTop="0dp"
                        android:layout_marginBottom="12dp"
                        android:accessibilityHeading="true" />
                    <LinearLayout
                        android:id="@+id/url_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="@dimen/settings_row_padding"
                        android:paddingHorizontal="0dp"
                        android:background="@drawable/bg_row_ripple"
                        android:clickable="true"
                        android:focusable="true"
                        android:screenReaderFocusable="true"
                        android:minHeight="48dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/mint_details_url"
                                android:textAppearance="@style/Text.RowTitle" />
                            <TextView
                                android:id="@+id/url_value"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/Text.SettingsCaption"
                                android:layout_marginTop="@dimen/settings_row_subtitle_gap" />
                        </LinearLayout>
                        <ImageView
                            android:importantForAccessibility="no"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="@dimen/space_s"
                            android:padding="14dp"
                            android:src="@drawable/ic_copy"
                            app:tint="@color/color_text_tertiary" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/software_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="@dimen/settings_row_padding"
                        android:paddingHorizontal="0dp"
                        android:visibility="gone">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/mint_details_software"
                            android:textAppearance="@style/Text.RowTitle" />
                        <TextView
                            android:id="@+id/software_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/Text.SettingsCaption"
                            android:textAlignment="textEnd"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/space_m" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/version_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="@dimen/settings_row_padding"
                        android:paddingHorizontal="0dp"
                        android:visibility="gone">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/mint_details_version"
                            android:textAppearance="@style/Text.RowTitle" />
                        <TextView
                            android:id="@+id/version_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/Text.SettingsCaption"
                            android:textAlignment="textEnd"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/space_m" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/contact_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginTop="@dimen/settings_section_gap">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/Text.SettingsSection"
                        android:text="@string/mint_details_contact"
                        android:textAllCaps="false"
                        android:layout_marginTop="0dp"
                        android:layout_marginBottom="12dp"
                        android:accessibilityHeading="true" />
                    <LinearLayout
                        android:id="@+id/contact_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/Text.SettingsSection"
                    android:text="@string/mint_details_actions"
                    android:textAllCaps="false"
                    android:layout_marginTop="@dimen/settings_section_gap"
                    android:layout_marginBottom="12dp"
                    android:accessibilityHeading="true" />
                <LinearLayout
                    style="@style/Widget.Numo.SettingsGroup">
                    <LinearLayout
                        android:id="@+id/set_lightning_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="@dimen/settings_row_padding"
                        android:paddingHorizontal="0dp"
                        android:background="@drawable/bg_row_ripple"
                        android:clickable="true"
                        android:focusable="true"
                        android:screenReaderFocusable="true"
                        android:minHeight="48dp">
                        <ImageView
                            android:importantForAccessibility="no"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="@dimen/space_m"
                            android:src="@drawable/ic_lightning_bolt"
                            app:tint="?attr/colorOnSurfaceVariant" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/Text.RowTitle"
                            android:text="@string/mints_set_as_lightning" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/delete_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="@dimen/settings_row_padding"
                    android:paddingHorizontal="0dp"
                    android:background="@drawable/bg_row_ripple"
                    android:clickable="true"
                    android:focusable="true"
                    android:screenReaderFocusable="true"
                    android:minHeight="48dp">
                    <ImageView
                        android:importantForAccessibility="no"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="@dimen/space_m"
                        android:src="@drawable/ic_trash"
                        app:tint="@color/color_error" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/Text.RowTitle"
                        android:text="@string/mint_details_delete"
                        android:textColor="@color/color_error" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.electricdreams.numo.ui.components.SettingsPageLayout>
