<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingHorizontal="@dimen/space_xl"
    android:paddingVertical="@dimen/space_l">

    <!-- A basket's thumbnails stack upward into the top padding (StackedAvatarsView), so the
         row must not clip them -->

    <com.electricdreams.numo.feature.insights.StackedAvatarsView
        android:id="@+id/avatars"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/tx_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/row_icon_gap"
        style="@style/Text.BodyBold"
        android:ellipsize="end"
        android:maxLines="1"
        app:layout_constraintStart_toEndOf="@id/avatars"
        android:layout_marginEnd="@dimen/space_l"
        app:layout_constraintEnd_toStartOf="@id/tx_total"
        app:layout_constraintTop_toTopOf="@id/avatars"
        tools:text="3 × Black hat +2 more" />

    <TextView
        android:id="@+id/tx_meta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/row_icon_gap"
        android:layout_marginTop="@dimen/row_subtitle_gap"
        style="@style/Text.Caption"
        android:ellipsize="end"
        android:maxLines="1"
        app:layout_constraintStart_toEndOf="@id/avatars"
        android:layout_marginEnd="@dimen/space_l"
        app:layout_constraintEnd_toStartOf="@id/tx_total"
        app:layout_constraintTop_toBottomOf="@id/tx_title"
        tools:text="Sat · 14:22" />

    <TextView
        android:id="@+id/tx_total"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/Text.BodyBold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:text="₿0.06M" />

</androidx.constraintlayout.widget.ConstraintLayout>
