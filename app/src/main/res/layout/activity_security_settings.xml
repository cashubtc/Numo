<?xml version="1.0" encoding="utf-8"?>
<com.electricdreams.numo.ui.components.SettingsPageLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top App Bar -->

        <com.electricdreams.numo.ui.components.NumoTopBar
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:topBarTitle="@string/settings_security_title"
            app:layout_constraintTop_toTopOf="parent"
            android:minHeight="64dp"
            app:topBarSettingsStyle="true" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/top_bar"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/security_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp"
                android:paddingHorizontal="@dimen/settings_page_margin">

                <!-- ==================== -->

                <!-- WALLET BACKUP SECTION -->

                <!-- ==================== -->

                <TextView
                    android:text="@string/security_settings_section_backup"
                    style="@style/Widget.Numo.SettingsSectionTitle"
                    android:textAllCaps="false"
                    android:layout_marginTop="@dimen/settings_section_gap"
                    android:accessibilityHeading="true" />

                <!-- Security Info Card -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="@dimen/space_s"
                    android:padding="@dimen/settings_row_padding"
                    android:background="@drawable/bg_settings_warning">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:importantForAccessibility="no"
                            android:layout_width="@dimen/icon_size_small"
                            android:layout_height="@dimen/icon_size_small"
                            android:layout_marginEnd="@dimen/space_m"
                            android:src="@drawable/ic_shield"
                            app:tint="@color/color_warning" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/security_settings_card_title"
                            android:textAppearance="@style/Text.RowTitle" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:text="@string/security_settings_card_body"
                        android:textAppearance="@style/Text.SettingsBody"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

                <LinearLayout
                    style="@style/Widget.Numo.SettingsGroup">

                    <com.electricdreams.numo.ui.components.SettingsRowView
                        android:id="@+id/backup_mnemonic_item"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:rowIcon="@drawable/ic_key"
                        app:rowTitle="@string/security_settings_backup_mnemonic_title"
                        app:rowSubtitle="@string/security_settings_backup_mnemonic_subtitle"
                        app:rowShowChevron="true"
                        style="@style/Widget.Numo.SettingsRow" />

                    <com.electricdreams.numo.ui.components.SettingsRowView
                        android:id="@+id/device_backup_item"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:rowIcon="@drawable/ic_cloud_done"
                        app:rowTitle="@string/security_settings_device_backup_title"
                        app:rowSubtitle="@string/security_settings_device_backup_subtitle"
                        app:rowShowChevron="true"
                        style="@style/Widget.Numo.SettingsRow" />

                </LinearLayout>

                <!-- ===================== -->

                <TextView
                    android:text="@string/security_settings_section_pin_protection"
                    style="@style/Widget.Numo.SettingsSectionTitle"
                    android:textAllCaps="false"
                    android:layout_marginTop="@dimen/settings_section_gap"
                    android:accessibilityHeading="true" />

                <!-- PIN Info Card -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="@dimen/space_s"
                    android:padding="@dimen/space_l"
                    android:background="@drawable/bg_settings_info">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:importantForAccessibility="no"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="@dimen/space_m"
                            android:src="@drawable/ic_lock"
                            app:tint="@color/color_icon_security_green" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/security_settings_pin_info_title"
                            android:textAppearance="@style/Text.Chip"
                            android:textColor="?attr/colorPrimary" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:text="@string/security_settings_pin_info_body"
                        android:textAppearance="@style/Text.SettingsCaption"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

                <!-- Set PIN Item -->

                <LinearLayout
                    style="@style/Widget.Numo.SettingsGroup">

                    <com.electricdreams.numo.ui.components.SettingsRowView
                        android:id="@+id/setup_pin_item"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:rowIcon="@drawable/ic_lock"
                        app:rowTitle="@string/security_settings_setup_pin_title"
                        app:rowSubtitle="@string/security_settings_setup_pin_subtitle"
                        app:rowShowChevron="true"
                        style="@style/Widget.Numo.SettingsRow" />

                    <com.electricdreams.numo.ui.components.SettingsRowView
                        android:id="@+id/change_pin_item"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        app:rowIcon="@drawable/ic_edit"
                        app:rowTitle="@string/security_settings_change_pin_title"
                        app:rowSubtitle="@string/security_settings_change_pin_subtitle"
                        app:rowShowChevron="true"
                        style="@style/Widget.Numo.SettingsRow" />

                    <com.electricdreams.numo.ui.components.SettingsRowView
                        android:id="@+id/remove_pin_item"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        app:rowIcon="@drawable/ic_close"
                        app:rowIconTint="@color/color_warning_red"
                        app:rowTitle="@string/security_settings_remove_pin_title"
                        app:rowTitleColor="@color/color_warning_red"
                        app:rowSubtitle="@string/security_settings_remove_pin_subtitle"
                        app:rowShowChevron="true"
                        style="@style/Widget.Numo.SettingsRow" />

                </LinearLayout>

                <!-- Wallet Recovery Section -->

                <TextView
                    android:text="@string/security_settings_section_recovery"
                    style="@style/Widget.Numo.SettingsSectionTitle"
                    android:textAllCaps="false"
                    android:layout_marginTop="@dimen/settings_section_gap"
                    android:accessibilityHeading="true" />

                <LinearLayout
                    style="@style/Widget.Numo.SettingsGroup">

                    <com.electricdreams.numo.ui.components.SettingsRowView
                        android:id="@+id/restore_wallet_item"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:rowIcon="@drawable/ic_restore"
                        app:rowTitle="@string/security_settings_restore_wallet_title"
                        app:rowSubtitle="@string/security_settings_restore_wallet_subtitle"
                        app:rowShowChevron="true"
                        style="@style/Widget.Numo.SettingsRow" />

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.electricdreams.numo.ui.components.SettingsPageLayout>
