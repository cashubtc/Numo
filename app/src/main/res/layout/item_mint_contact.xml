<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="@dimen/row_padding_vertical"
    android:paddingHorizontal="0dp">
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/contact_method"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Email"
            android:textAppearance="@style/Text.RowTitle" />
        <TextView
            android:id="@+id/contact_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="contact@example.com"
            android:textAppearance="@style/Text.SettingsCaption"
            android:layout_marginTop="@dimen/settings_row_subtitle_gap" />
    </LinearLayout>
    <ImageView
        android:id="@+id/copy_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="@dimen/space_s"
        android:padding="14dp"
        android:src="@drawable/ic_copy"
        app:tint="@color/color_text_tertiary"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/mint_details_copy" />
    <ImageView
        android:importantForAccessibility="no"
        android:id="@+id/contact_icon"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</LinearLayout>
