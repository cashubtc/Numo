<?xml version="1.0" encoding="utf-8"?>
<com.electricdreams.numo.ui.components.SettingsPageLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top App Bar -->

        <com.electricdreams.numo.ui.components.NumoTopBar
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:topBarTitle="@string/developer_settings_title"
            app:layout_constraintTop_toTopOf="parent"
            android:minHeight="64dp"
            app:topBarSettingsStyle="true" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/top_bar"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp"
                android:paddingHorizontal="16dp">

                <!-- Debugging Section -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/developer_settings_section_debugging"
                    android:textAppearance="@style/Text.SettingsSection"
                    android:textAllCaps="false"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="12dp"
                    android:accessibilityHeading="true" />

                <!-- Restart Onboarding -->

                <LinearLayout
                    style="@style/Widget.Numo.SettingsGroup">

                    <LinearLayout
                        android:id="@+id/restart_onboarding_item"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/settings_horizontal_padding"
                        android:minHeight="72dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:screenReaderFocusable="true">

                        <ImageView
                            android:importantForAccessibility="no"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="@dimen/space_l"
                            android:src="@drawable/ic_restore"
                            app:tint="?attr/colorPrimary"
                            android:padding="10dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/developer_settings_restart_onboarding_title"
                                android:textAppearance="@style/Text.RowTitle" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/developer_settings_restart_onboarding_subtitle"
                                android:textAppearance="@style/Text.SettingsCaption"
                                android:layout_marginTop="2dp" />

                        </LinearLayout>

                        <ImageView
                            android:importantForAccessibility="no"
                            android:layout_width="@dimen/icon_size_small"
                            android:layout_height="@dimen/icon_size_small"
                            android:src="@drawable/ic_chevron_forward"
                            app:tint="@color/color_icon_secondary" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btcmap_reset"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/settings_horizontal_padding"
                        android:minHeight="72dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:screenReaderFocusable="true">

                        <ImageView
                            android:importantForAccessibility="no"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="@dimen/space_l"
                            android:src="@drawable/ic_btcmap_logo"
                            app:tint="?attr/colorPrimary"
                            android:padding="10dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/developer_settings_reset_btcmap_promo_title"
                                android:textAppearance="@style/Text.RowTitle" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/developer_settings_reset_btcmap_promo_subtitle"
                                android:textAppearance="@style/Text.SettingsCaption"
                                android:layout_marginTop="2dp" />

                        </LinearLayout>

                        <ImageView
                            android:importantForAccessibility="no"
                            android:layout_width="@dimen/icon_size_small"
                            android:layout_height="@dimen/icon_size_small"
                            android:src="@drawable/ic_chevron_forward"
                            app:tint="@color/color_icon_secondary" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/delay_lightning_invoice_item"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="72dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/settings_horizontal_padding"
                        android:paddingVertical="@dimen/space_m"
                        android:screenReaderFocusable="true">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="@dimen/space_l"
                            android:src="@drawable/ic_lightning_bolt"
                            app:tint="?attr/colorPrimary"
                            android:contentDescription="@null"
                            android:padding="10dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="@dimen/space_l">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/developer_settings_lightning_invoice_title"
                                android:textAppearance="@style/Text.RowTitle" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/developer_settings_lightning_invoice_subtitle"
                                android:textAppearance="@style/Text.SettingsCaption"
                                android:layout_marginTop="2dp" />

                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/delay_lightning_invoice_switch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:contentDescription="@string/developer_settings_lightning_invoice_title" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/error_logs_item"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/settings_horizontal_padding"
                        android:minHeight="72dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:screenReaderFocusable="true">

                        <ImageView
                            android:importantForAccessibility="no"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="@dimen/space_l"
                            android:src="@drawable/ic_warning"
                            app:tint="?attr/colorPrimary"
                            android:padding="10dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/developer_error_logs_title"
                                android:textAppearance="@style/Text.RowTitle" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/developer_error_logs_subtitle"
                                android:textAppearance="@style/Text.SettingsCaption"
                                android:layout_marginTop="2dp" />

                        </LinearLayout>

                        <ImageView
                            android:importantForAccessibility="no"
                            android:layout_width="@dimen/icon_size_small"
                            android:layout_height="@dimen/icon_size_small"
                            android:src="@drawable/ic_chevron_forward"
                            app:tint="@color/color_icon_secondary" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/wallet_logs_item"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/settings_horizontal_padding"
                        android:minHeight="72dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:screenReaderFocusable="true">

                        <ImageView
                            android:importantForAccessibility="no"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="@dimen/space_l"
                            android:src="@drawable/ic_history"
                            app:tint="?attr/colorPrimary"
                            android:padding="10dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/developer_wallet_logs_title"
                                android:textAppearance="@style/Text.RowTitle" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/developer_wallet_logs_subtitle"
                                android:textAppearance="@style/Text.SettingsCaption"
                                android:layout_marginTop="2dp" />

                        </LinearLayout>

                        <ImageView
                            android:importantForAccessibility="no"
                            android:layout_width="@dimen/icon_size_small"
                            android:layout_height="@dimen/icon_size_small"
                            android:src="@drawable/ic_chevron_forward"
                            app:tint="@color/color_icon_secondary" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Warning Text -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/settings_horizontal_padding"
                    android:paddingTop="@dimen/space_l"
                    android:text="@string/developer_settings_warning"
                    android:textAppearance="@style/Text.SettingsCaption"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:background="@drawable/bg_settings_warning"
                    android:padding="@dimen/space_l"
                    android:layout_marginTop="@dimen/space_l" />

            </LinearLayout>

        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.electricdreams.numo.ui.components.SettingsPageLayout>
