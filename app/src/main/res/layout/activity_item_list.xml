<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.electricdreams.numo.ui.components.SettingsPageLayout
        android:id="@+id/catalog_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
>

            <!-- Top App Bar (hidden when showing empty state) -->

            <com.electricdreams.numo.ui.components.NumoTopBar
                android:id="@+id/top_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                app:topBarTitle="@string/item_list_toolbar_title"
                app:topBarSettingsStyle="true"
                app:topBarActionIcon="@drawable/ic_add"
                app:topBarActionTint="@color/m3_primary"
                app:topBarActionContentDescription="@string/item_list_add_item"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Regular Content: Items List (shown when items exist) -->

            <LinearLayout
                android:id="@+id/items_content"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible"
                app:layout_constraintTop_toBottomOf="@id/top_bar"
                app:layout_constraintBottom_toBottomOf="parent">

                <!-- Items RecyclerView -->

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/items_recycler_view"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    tools:listitem="@layout/item_product"
                    android:paddingHorizontal="@dimen/settings_page_margin"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp" />

                <!-- Bottom Actions Section (only shown when items exist) -->

                <LinearLayout
                    android:id="@+id/bottom_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/settings_page_margin"
                    android:paddingTop="@dimen/space_m"
                    android:paddingBottom="@dimen/space_xl"
                    android:background="@color/settings_background">

                    <!-- Top divider (hidden for UI refresh) -->

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_marginBottom="@dimen/space_l"
                        android:background="@color/color_divider"
                        android:visibility="gone" />

                    <!-- Import from CSV Button -->

                    <Button
                        android:id="@+id/import_csv_button"
                        style="@style/Widget.Button.Secondary.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/item_list_import_from_csv" />

                    <!-- Export to CSV Button -->

                    <Button
                        android:id="@+id/export_csv_button"
                        style="@style/Widget.Button.Secondary.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:text="@string/item_list_export_to_csv" />

                    <!-- Clear All Items Link -->

                    <TextView
                        android:id="@+id/clear_items_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/space_l"
                        android:background="?attr/selectableItemBackground"
                        android:padding="@dimen/space_s"
                        android:text="@string/item_list_clear_all"
                        android:textAppearance="@style/Text.Link"
                        android:textColor="@color/color_warning_red" />

                </LinearLayout>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.electricdreams.numo.ui.components.SettingsPageLayout>

    <!-- Keep the original empty catalog artwork full width, with its own navigation. -->
    <include
        android:id="@+id/empty_view"
        layout="@layout/layout_empty_state_items"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible" />

</FrameLayout>
