<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Numo.Settings" parent="Theme.Numo">
        <item name="android:windowBackground">@color/settings_background</item>
    </style>

    <style name="Theme.Numo.SettingsInput" parent="Theme.Numo.BottomSheet">
        <item name="colorPrimary">@color/m3_primary</item>
        <item name="colorOnPrimary">@color/m3_on_primary</item>
    </style>

    <style name="Widget.Numo.SettingsRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/settings_detail_row_height</item>
        <item name="rowIconTint">@color/m3_primary</item>
        <item name="rowShowChevron">true</item>
    </style>

    <style name="Widget.Numo.SettingsSection" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/settings_section_gap</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="Widget.Numo.SettingsSectionTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">0dp</item>
        <item name="android:layout_marginEnd">0dp</item>
        <item name="android:layout_marginBottom">@dimen/settings_section_title_gap</item>
        <item name="android:textAppearance">@style/Text.SettingsSection</item>
        <item name="android:accessibilityHeading">true</item>
    </style>

    <style name="Text.SettingsSection" parent="Text.RowTitle">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Widget.Numo.SettingsGroup" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_settings_group</item>
        <item name="android:clipToOutline">true</item>
    </style>

    <style name="Text.SettingsPageTitle" parent="Text.Heading1">
        <item name="android:gravity">start</item>
    </style>

    <style name="Text.SettingsBody" parent="Text.Body">
        <item name="fontFamily">sans-serif</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Text.SettingsCaption" parent="Text.RowSubtitle">
        <item name="fontFamily">sans-serif</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Widget.Numo.SettingsCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/settings_background</item>
        <item name="cardCornerRadius">@dimen/settings_card_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.Numo.SettingsChoice" parent="Widget.Material3.CompoundButton.RadioButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/settings_row_height</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:paddingTop">@dimen/settings_row_padding</item>
        <item name="android:paddingBottom">@dimen/settings_row_padding</item>
        <item name="android:background">@drawable/bg_settings_choice</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textAppearance">@style/Text.RowTitle</item>
        <item name="useMaterialThemeColors">true</item>
    </style>

    <style name="Widget.Numo.SettingsTextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/settings_background</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_input</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_input</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_input</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_input</item>
    </style>
    <style name="Text.SettingsInput" parent="Text.Body">
        <item name="fontFamily">sans-serif</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="Widget.Numo.SettingsSearch" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="hintEnabled">false</item>
        <item name="boxBackgroundColor">@color/settings_background</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_search</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_search</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_search</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_search</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">1dp</item>
        <item name="startIconDrawable">@drawable/ic_search</item>
        <item name="startIconTint">?attr/colorOnSurfaceVariant</item>
        <item name="endIconMode">clear_text</item>
        <item name="endIconContentDescription">@string/settings_clear_search</item>
    </style>

    <style name="Widget.Numo.SettingsAddButton" parent="Widget.Button.Secondary.Outlined">
        <item name="android:textAppearance">@style/Text.Button</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="icon">@drawable/ic_add</item>
        <item name="iconTint">?attr/colorPrimary</item>
        <item name="iconGravity">textStart</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:minHeight">@dimen/button_height</item>
    </style>
</resources>
